# Set these privately in Vercel. Never commit real values.
SIDOC_ENV=production
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sidoc-documents
SECRET_KEY=
BOOTSTRAP_TOKEN=
# Comma-separated hostnames, without https://. Vercel hostnames are also detected.
ALLOWED_HOSTS=

# Optional read-only tour, without a database. Remove or set 0 for the real app.
SIDOC_DEMO=0

# Optional Google OpenID Connect; backend-only credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional verified Google Workspace hd claim; leave blank for approved Gmail users.
GOOGLE_WORKSPACE_DOMAIN=
